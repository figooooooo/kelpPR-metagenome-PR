# Normalise line endings so that the GitHub archive matches checksums_sha256.txt
* text=auto eol=lf

*.tsv   text eol=lf
*.tab   text eol=lf
*.txt   text eol=lf
*.R     text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.cff   text eol=lf
*.json  text eol=lf
*.contree text eol=lf
*.fasta text eol=lf
